{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/(payload)/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/expired-holds",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/email-deliveries",
      "schedule": "43 3 * * *"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/privacy-retention",
      "schedule": "31 4 * * *"
    }
  ]
}
